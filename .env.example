# Supabase Configuration (Required for Authentication)
# Create a project at https://supabase.com and add Google + GitHub OAuth providers
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Anthropic API Key for live AI-powered analysis generation
# If not provided, the app uses the built-in professional analysis engine
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key
